# Telegram Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database Settings
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis Settings
REDIS_URL=rediss://default:password@host:6379

# API Keys
COINGECKO_API_KEY=
TWELVEDATA_API_KEY=
ETHERSCAN_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Security
SECRET_KEY=change-me-to-a-very-secure-key

# Admin (gets Pro tier automatically)
ADMIN_TELEGRAM_ID=your_telegram_user_id

# Public base URL (used for iFrame links, OAuth return bounce, etc.).
# REQUIRED on production (Render): https://your-app.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# cTrader Open API OAuth. Client ID/Secret come from an app you create at
# id.ctrader.com -> Open API -> Your applications. The redirect URI you register
# there must EXACTLY match the value below (leave blank to auto-derive it from
# PUBLIC_BASE_URL as https://<host>/api/trading/live/ctid/callback).
# Defaults below match the official cTrader docs (id.ctrader.com grantingaccess
# page + openapi.ctrader.com/apps/token). scope is `trading` (full) or `accounts`.
CTRADER_OAUTH_AUTHORIZE_URL=https://id.ctrader.com/my/settings/openapi/grantingaccess/
CTRADER_OAUTH_TOKEN_URL=https://openapi.ctrader.com/apps/token
CTRADER_OAUTH_SCOPE=trading
CTRADER_OAUTH_REDIRECT_URI=
# How often (minutes) the background sweep refreshes expiring tokens.
CTRADER_TOKEN_REFRESH_MINUTES=30

# cTrader Open API JSON-over-WebSocket endpoints (official broker channel; the
# legacy connect.ctrader.com REST host is decommissioned). 5036 = JSON protocol.
CTRADER_WS_DEMO_URL=wss://demo.ctraderapi.com:5036
CTRADER_WS_LIVE_URL=wss://live.ctraderapi.com:5036
# Seconds to wait for a broker request/execution event before failing it.
CTRADER_WS_TIMEOUT_SECONDS=25
